diff --git a/Compositor/UI/ToolbarCompatibility.swift b/Compositor/UI/ToolbarCompatibility.swift
new file mode 100644
index 0000000..905092a
--- /dev/null
+++ b/Compositor/UI/ToolbarCompatibility.swift
@@ -0,0 +1,9 @@
+import SwiftUI
+
+extension ToolbarContent {
+    /// `sharedBackgroundVisibility` exists only on macOS 26, where it keeps the tab strip off the toolbar's glass
+    /// background. Earlier systems have no shared background to hide, so the item is returned unchanged.
+    @ToolbarContentBuilder func hidingSharedBackground() -> some ToolbarContent {
+        if #available(macOS 26.0, *) { self.sharedBackgroundVisibility(.hidden) } else { self }
+    }
+}
